rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@pizzaparadize.com'
      );
    }

    function isStaff() {
      return request.auth != null && exists(/databases/$(database)/documents/delivery_staff/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /delivery_staff/{staffId} {
       allow read: if isAdmin() || (request.auth != null && request.auth.uid == staffId);
       allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /menu_items/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cart_items/{cartItemId} {
      // Allow user to read their own cart items (for both `get` and `list`/`query`).
      // The client MUST query with `where('userId', '==', request.auth.uid)`.
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow user to create a cart item for themselves.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Allow user to update their own cart item, and prevent them from changing the owner.
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                                            && request.auth.uid == request.resource.data.userId;

      // Allow user to delete their own cart item.
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /orders/{orderId} {
       allow create: if request.auth != null
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.status == 'PENDING'
                     && request.resource.data.otpVerified == false;
       allow update: if isAdmin() || isStaff();
       allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin() || isStaff());

       match /private/{document} {
         allow read: if request.auth != null && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
         allow write: if false;
       }
    }

    match /app_settings/{document=**} {
       allow read: if true;
       allow write: if isAdmin();
    }
  }
}
