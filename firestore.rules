rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if the user is a delivery staff member
    function isStaff() {
      return exists(/databases/$(database)/documents/delivery_staff/$(request.auth.uid));
    }

    // Menu Items: Publicly readable, writable only by admin (not via client)
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Cart Items: Private to the user
    match /cart_items/{cartItemId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete, read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Orders:
    // - Users can read their own orders.
    // - Users can create their own orders but must set status to PENDING and otpVerified to false.
    // - Only staff can update orders (e.g. status, OTP verification).
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == "PENDING"
                    && request.resource.data.otpVerified == false;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isStaff());
      allow update: if request.auth != null && isStaff();
      allow delete: if false; // Orders should not be deleted by clients

      // Private data sub-collection (e.g., OTP)
      // Only the customer can read this. Staff cannot.
      match /private/{document} {
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
        allow write: if false; // Only written by Cloud Functions
      }
    }

    // App Settings: Publicly readable (contains tax, fees)
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Delivery Staff: Protected profile access
    // Only Admin (via backend) can create/modify staff profiles.
    match /delivery_staff/{staffId} {
      allow read: if request.auth != null; // Allow authenticated users to read staff info
      allow write: if false; // Prevent users from self-promoting to staff
    }

    // Users: Private profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
